{
    "name": "ghijk/cp-notifications",
    "description": "Control-panel notifications and acknowledgement tracking for Statamic.",
    "type": "statamic-addon",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Ghijk\\CpNotifications\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ghijk\\CpNotifications\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "pest --exclude-group=browser",
        "test:browser": "pest tests/Browser",
        "test:all": [
            "@test",
            "@test:browser"
        ]
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8 || ^11.0",
        "laravel/pint": "^1.30",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Cp Notifications",
            "description": "Cp Notifications addon"
        },
        "laravel": {
            "providers": [
                "Ghijk\\CpNotifications\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
